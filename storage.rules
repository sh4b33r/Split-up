rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSmallImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isMember(roomId) {
      return request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/rooms/$(roomId)).data.memberIds;
    }

    // Receipts and payment-proof photos: room members only, images up to 5 MB.
    match /rooms/{roomId}/{allPaths=**} {
      allow read: if isMember(roomId);
      allow create: if isMember(roomId) && isSmallImage();
    }

    // Profile photos.
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid && isSmallImage();
    }
  }
}

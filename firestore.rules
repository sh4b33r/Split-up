rules_version = '2';

// Clients can read what they belong to and write almost nothing. Rooms,
// members, splits, shares, recurring rules, activity and invites are written
// only by Cloud Functions (the Admin SDK bypasses these rules), so a modified
// app cannot set a status or an amount directly.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(roomId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds;
    }

    // A user's private document. The profile is saved through the
    // updateProfile function; the app itself may only add or remove its
    // own push tokens.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['fcmTokens']);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens']);

      match /notifications/{notificationId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }
    }

    match /rooms/{roomId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      // Someone waiting for approval can see their own request.
      match /joinRequests/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
      }

      // members, splits, shares, recurringRules, activity, joinRequests
      match /{document=**} {
        allow read: if isMember(roomId);
      }
    }

    // "Everything I owe" and "everything owed to me", across all rooms.
    match /{path=**}/shares/{shareId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || resource.data.payerId == request.auth.uid);
    }

    // An email invite is visible to the verified owner of that address and
    // to members of the room it is for.
    match /invites/{inviteId} {
      allow read: if signedIn() && (
        (request.auth.token.email_verified == true
          && request.auth.token.email.lower() == resource.data.emailLower)
        || isMember(resource.data.roomId)
      );
    }

    // roomCodes, inviteTokens, rateLimits and mail are server-only: no rule
    // matches them, so every client read and write is denied.
  }
}
